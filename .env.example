# Envio do formulario de contato (opcional).
# Sem estas variaveis, a rota /api/contact apenas registra a mensagem no log do servidor.
# Para ativar o envio real, crie uma conta em https://resend.com e configure na Vercel
# (Project Settings > Environment Variables) ou em um arquivo .env.local.

RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remetente. Use um dominio verificado na Resend; o padrao e o remetente de teste.
CONTACT_FROM_EMAIL=onboarding@resend.dev